# Dashboard Estoque TI - Configurações de Ambiente
# Copie este arquivo para .env e configure as variáveis

# === AUTENTICAÇÃO ===
ADMIN_PASSWORD=admin123_CHANGE_ME
VIEWER_PASSWORD=view123_CHANGE_ME

# === SEGURANÇA ===
SECRET_KEY=your-secret-key-here-CHANGE-ME
JWT_SECRET=your-jwt-secret-here-CHANGE-ME

# === BANCO DE DADOS ===
# SQLite (desenvolvimento local):
# DATABASE_URL=sqlite:///estoque_ti.db

# PostgreSQL (produção):
DATABASE_URL=postgresql://user:password@localhost:5432/estoque_ti

# Streamlit Cloud PostgreSQL (configurado automaticamente via secrets):
# DATABASE_URL será obtido do st.secrets['DATABASE_URL']

# === CONFIGURAÇÕES GERAIS ===
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# === RATE LIMITING ===
MAX_REQUESTS_PER_MINUTE=30
MAX_LOGIN_ATTEMPTS=5

# === CACHE ===
CACHE_TTL_SECONDS=300
ENABLE_CACHE=true
